# PPanel 主控配置（开发环境）
MASTER_HOST=127.0.0.1
MASTER_PORT=8001

# 认证
JWT_SECRET=ppm-dev-secret-3f8a1c92d7e64b05a1c2
JWT_EXPIRE_MINUTES=43200

# 商城对接 X-API-Key（留空则 /api/open 全部禁用）
MASTER_API_KEY=ppopen_dev_5f3a9c21e8d74b06

# 首次启动管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 存储
DB_URL=sqlite:///./data/master.db

# 实例可选镜像（需与被控节点配置一致）
PYTHON_IMAGES=["python:3.9-slim","python:3.10-slim","python:3.11-slim","python:3.12-slim"]
PHP_IMAGES=["php:8.2-cli","php:8.3-cli","php:8.4-cli"]

# 上传/下载经主控中转的内存上限（MB）
TRANSFER_LIMIT_MB=200
