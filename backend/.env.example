# PPanel 面板配置样例：复制为 .env 后按需修改

# 面板监听（生产建议保持 127.0.0.1 并用 Nginx 反代 + 鉴权；纯内网可直接 0.0.0.0）
PANEL_HOST=127.0.0.1
PANEL_PORT=8000

# JWT 密钥（务必修改为随机长字符串）与过期时间（分钟）
JWT_SECRET=please-change-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# 商城系统对接预留：设置后管理级接口可携带 X-API-Key 调用（视为 admin）
PANEL_API_KEY=

# 首次启动自动创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 实例宿主机目录根（约定 /data/inst/{instance_id}，容器内挂载为 /app）
DATA_ROOT=/data/inst

# SQLite 位置
DB_URL=sqlite:///./data/ppanel.db

# 外部端口分配范围与应用容器内端口
PORT_START=30000
PORT_END=39999
INNER_APP_PORT=8000

# 上传单文件上限（MB）
UPLOAD_LIMIT_MB=50

# 容器 PID 上限
PIDS_LIMIT=256

# 实例容器所在独立 docker 网络
DOCKER_NETWORK=ppanel-net

# 可选 Python 镜像（JSON 数组）
#PYTHON_IMAGES=["python:3.9-slim","python:3.10-slim","python:3.11-slim","python:3.12-slim"]
